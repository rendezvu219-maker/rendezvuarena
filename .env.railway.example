# Railway injects PORT automatically. Do not set a fixed PORT.
NODE_ENV=production
APP_ORIGIN=https://replace-with-your-generated-domain.up.railway.app
TRUST_PROXY=true
COOKIE_SECURE=true

AUTH_SECRET=replace-with-at-least-64-random-hex-characters
ADMIN_USERNAME=replace-admin-username
ADMIN_EMAIL=replace-with-your-real-email@example.net
ADMIN_PASSWORD=replace-with-a-unique-strong-password
DIVINE_CARD_ADMIN_EMAIL=replace-with-content-owner@example.net

# Attach one Railway Volume at /data. These explicit paths are recommended;
# the application also falls back to RAILWAY_VOLUME_MOUNT_PATH automatically.
DATABASE_PATH=/data/rendezvu-arena.sqlite
UPLOAD_PATH=/data/uploads
MAX_UPLOAD_BYTES=3145728

API_RATE_LIMIT_PER_MINUTE=100
LOGIN_FAILURE_LIMIT=5
REGISTER_RATE_LIMIT_MAX=3
ALLOW_BEARER_TOKEN_RESPONSE=false
ALLOW_DIRECT_HOST_REGISTRATION=false
ALLOW_MANUAL_TOURNAMENT_CREATION=false
ENABLE_DEV_TEST_CONSOLE=false

PUBLIC_CONTACT_EMAIL=replace-with-public-contact@example.net
PUBLIC_SUPPORT_URL=
STARTGG_API_TOKEN=

# Account email verification through Resend. Verify the sending domain first.
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=re_replace_with_domain_scoped_key
EMAIL_FROM=RendezVu Arena <verify@your-domain.example>
EMAIL_CODE_SECRET=replace-with-a-separate-64-byte-random-secret
EMAIL_VERIFICATION_SEND_LIMIT=6
EMAIL_VERIFICATION_ATTEMPT_LIMIT=10

# start.gg OAuth application. The redirect URL in the start.gg developer portal must
# exactly match https://YOUR_DOMAIN/api/connections/startgg/callback.
STARTGG_CLIENT_ID=
STARTGG_CLIENT_SECRET=
STARTGG_REDIRECT_URI=https://replace-with-your-domain/api/connections/startgg/callback
STARTGG_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-64-byte-random-secret

# Optional Challonge OAuth. Register this exact callback in the Challonge app.
# Without OAuth configuration, Challonge profile links remain available for manual Host review.
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
CHALLONGE_REDIRECT_URI=https://replace-with-your-domain/api/connections/challonge/callback
CHALLONGE_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-64-byte-random-secret
