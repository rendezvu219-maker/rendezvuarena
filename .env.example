# Runtime
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=false
COOKIE_SECURE=false

# Required: generate at least 32 random bytes; never reuse the example value.
AUTH_SECRET=replace-with-at-least-32-random-bytes-of-entropy

# Database and uploads
DATABASE_PATH=./data/rendezvu-arena.sqlite
UPLOAD_PATH=./data/uploads
MAX_UPLOAD_BYTES=3145728

# Authentication and abuse controls
API_RATE_LIMIT_PER_MINUTE=100
LOGIN_FAILURE_LIMIT=5
REGISTER_RATE_LIMIT_MAX=3
ALLOW_BEARER_TOKEN_RESPONSE=false
ALLOW_DIRECT_HOST_REGISTRATION=false
ALLOW_MANUAL_TOURNAMENT_CREATION=false

# Bootstrap accounts — replace all values before first production startup.
ADMIN_USERNAME=admin
ADMIN_EMAIL=replace-admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
DIVINE_CARD_ADMIN_EMAIL=replace-content-owner@example.com

# Account verification email (production: verify the sender domain with Resend)
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=
EMAIL_FROM=RendezVu Arena <verify@your-domain.example>
EMAIL_CODE_SECRET=replace-with-a-separate-64-byte-random-secret
EMAIL_VERIFICATION_SEND_LIMIT=6
EMAIL_VERIFICATION_ATTEMPT_LIMIT=10

# Optional integrations / diagnostics
STARTGG_API_TOKEN=
STARTGG_CLIENT_ID=
STARTGG_CLIENT_SECRET=
STARTGG_REDIRECT_URI=http://localhost:3000/api/connections/startgg/callback
STARTGG_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-64-byte-random-secret
ENABLE_DEV_TEST_CONSOLE=false

# Public legal/contact pages. A real monitored email is required before launch.
PUBLIC_CONTACT_EMAIL=rendezvous2193@gmail.com
# Keep optional support disabled for the initial release until rights/licensing is cleared.
PUBLIC_SUPPORT_URL=

# Railway automatically supplies this when a Volume is attached.
# RAILWAY_VOLUME_MOUNT_PATH=/data

# Optional Challonge OAuth. Without these values, users may still save a public
# Challonge profile link for manual Host review.
CHALLONGE_CLIENT_ID=
CHALLONGE_CLIENT_SECRET=
CHALLONGE_REDIRECT_URI=http://localhost:3000/api/connections/challonge/callback
CHALLONGE_TOKEN_ENCRYPTION_KEY=replace-with-a-separate-64-byte-random-secret
